        <mxCell id="0AqxiJY5lXnOBD0MTKCE-18" value="&lt;div&gt;for (int i := coordinates.Count - 1; i &amp;gt; 0; --i) loop&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: normal;&quot;&gt;&lt;span style=&quot;white-space:pre&quot;&gt;&#x9;&lt;/span&gt;for (int j := i - 1; j &amp;gt;= 0; --j) loop&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: normal;&quot;&gt;&lt;span style=&quot;white-space:pre&quot;&gt;&#x9;&#x9;&lt;/span&gt;if (coordinates[j] = coordinates[i]) then&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: normal;&quot;&gt;&lt;span style=&quot;white-space:pre&quot;&gt;&#x9;&#x9;&#x9;&lt;/span&gt;throw new Exception();&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: normal;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;endif&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: normal;&quot;&gt;&lt;span style=&quot;white-space:pre&quot;&gt;&#x9;&lt;/span&gt;endloop&lt;/span&gt;&lt;/div&gt;&lt;div&gt;endloop&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;segments := coordinates.ToList().ConvertAll(x =&amp;gt; new Segment(x));&lt;/div&gt;&lt;div&gt;sunken := false;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;labelPadding=0;spacing=8;" parent="1" vertex="1">
          <mxGeometry x="-15" y="50" width="385" height="150" as="geometry" />
        </mxCell>
