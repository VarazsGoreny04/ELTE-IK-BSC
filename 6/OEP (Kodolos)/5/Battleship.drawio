          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="0AqxiJY5lXnOBD0MTKCE-20" value="&lt;div&gt;Segment? hitSegment := segments.FirstOrDefault(x =&amp;gt; x.Coordinate = coordinate);&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;if (hitSegment is not null) then&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: normal;&quot;&gt;&lt;span style=&quot;white-space:pre&quot;&gt;&#x9;&lt;/span&gt;hitSegment.Hit();&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: normal;&quot;&gt;&lt;span style=&quot;white-space:pre&quot;&gt;&#x9;&lt;/span&gt;sunken = segments.All(x =&amp;gt; x.IsDamaged);&lt;/span&gt;&lt;/div&gt;&lt;div&gt;endif&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;labelPadding=0;spacing=8;" parent="1" vertex="1">
